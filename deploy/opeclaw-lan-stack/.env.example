# --- General ---
TZ=America/Mexico_City

# --- Images ---
OPECLAW_IMAGE=ghcr.io/opeclaw/opeclaw:latest
VLLM_IMAGE=vllm/vllm-openai:latest

# --- vLLM model setup ---
VLLM_MODEL=/models/deepseek-r1-70b-awq
SERVED_MODEL_NAME=deepseek-r1-70b
VLLM_DTYPE=auto
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=8
NVIDIA_VISIBLE_DEVICES=all
HF_TOKEN=

# --- internal API wiring ---
INTERNAL_OPENAI_KEY=PPN_LOCAL_KEY_CHANGE_ME

# --- Reverse proxy security ---
# 0 = no bearer auth in LAN, 1 = require Bearer token
REQUIRE_AUTH=1
BEARER_TOKEN=CHANGE_ME_STRONG_TOKEN
RATE_LIMIT_RPM=60
